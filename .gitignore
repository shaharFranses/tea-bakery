# Godot 4
.godot/
*.translation
export.cfg
export_credentials.cfg
.import/
mono_crash.*.json

# Web export output (build artifacts, not source) - never commit
export/
build/
*.wasm
*.pck
*.zip
*.tpz

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
*.log

# Deploy tool state
.vercel/
.netlify/

# PKD starter: web/ holds the frozen gated build and IS committed; the slim engine template is committed.
!web/*.wasm
!web/*.pck
!engine/pkd_web_release_slim.zip
dist/
qa/results/ci-*/
__pycache__/

# ART (tea-bakery): proposal images and generated scratch stay local; production art lives in assets/
art/mocks/
art/*.png
art/**/*@2x.png
art/tools/out/
art/tools/*.png
art/tools/.venv/
art/tools/venv/
art/**/*.zip
art/covers/out/
